	int number=12345;
	int sum of Digits=calculate the sumofDigits(number);
	System.out.println("sum of Digits of"+number+"is:"+sumofDigits);

}
public static int calculate sum of Digits(int number) {
	int sum=0;
	while(number>0) {
		int digit=number%10;
		sum=sum+digit;
		number=number/10;
		return sum;
	}
}}
(OUTPUT)=>Sum of digits of 12345 is: 15 .
