System.out.println("Enter any Number");
int number=sc.nextInt();
if(ispalindrome(number)) {
	System.out.println(number+"is a palindrome...");
}else {
	System.out.println(number+"is a not a palindrome...");
	

public static boolean ispalindrome(intnum) {
	int originalNumber=num;
	int reverseNumber=0;
	while(num!=0) {
		int digit=num%10;
		reversedNumber=reverse num*10+digit;
		num=num/10;
	}
	return original Number==reversed Number;
}}
